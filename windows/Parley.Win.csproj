<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Parley</AssemblyName>
    <RootNamespace>Parley</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>0.1.0</Version>
    <ApplicationIcon>Parley.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
  </ItemGroup>

  <!-- Bundled voice preview samples (shared with the macOS app's resources). -->
  <ItemGroup>
    <Content Include="..\app\Sources\Parley\Resources\voice-previews\*.mp3"
             Link="voice-previews\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\app\Sources\Parley\Resources\branding\*.png"
             Link="branding\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The relay's source: setup step 7 ("Eigenes Relais · 1 Klick") deploys it with wrangler
       (RelaySetup.cs) — as scripts/make-app.sh bundles it into the macOS app. -->
  <ItemGroup>
    <Content Include="..\relay\src\**\*"
             Link="relay\src\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\relay\wrangler.jsonc;..\relay\package.json;..\relay\package-lock.json;..\relay\tsconfig.json;..\relay\worker-configuration.d.ts"
             Link="relay\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
