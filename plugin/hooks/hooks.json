{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/stop-hook.sh\"",
            "commandWindows": "bash \"${PLUGIN_ROOT}/scripts/stop-hook.sh\"",
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
