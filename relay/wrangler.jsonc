{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parley-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // One Durable Object per pairing room (see docs/IPHONE.md, "Relay protocol").
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // SQLite-backed, so the relay runs on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Every WebSocket message is an invocation; a log event for each used up the free plan's
  // 200k events a day. Kept: the relay's own warnings and uncaught exceptions.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
